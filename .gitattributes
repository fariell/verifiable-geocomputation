# 统一换行符:仓库内一律 LF,检出时按平台自动转换
* text=auto eol=lf

# 文本类型
*.md    text eol=lf
*.txt   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# 脚本必须 LF(否则 Linux CI 上 shebang 会失效)
*.sh    text eol=lf
*.py    text eol=lf

# 二进制:禁止任何转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary

# SVG 是文本,但按文本处理即可
*.svg   text eol=lf
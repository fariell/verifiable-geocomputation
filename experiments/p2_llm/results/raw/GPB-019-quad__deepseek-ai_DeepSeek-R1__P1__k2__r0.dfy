// ===========================================================================
//  GeoProofBench · P-004
//  算子 : Horn (1981) 3x3 有限差分坡度
//  覆盖 : GPB-019 (二次曲面精确性/三次曲面余项)
//  环境 : Dafny 4.11 · 验证命令 dafny verify P004_consistency.dfy
// ===========================================================================

module HornConsistency {
  import opened HornSlope

  // ------------------------------------------------------------------
  // 二次曲面: z = A·x + B·y + C + D·x² + E·x·y + F·y²
  // 在原点(0,0)处,Horn算子应精确恢复线性系数(A,B)
  // ------------------------------------------------------------------
  lemma QuadraticExact(A: real, B: real, C: real, D: real, E: real, F: real, w: real)
    requires w > 0.0
    ensures 
      // 定义3x3窗口高程值 (中心点e未使用)
      var a := A*(-w) + B*(-w) + C + D*(w*w) + E*(w*w) + F*(w*w);
      var b := A*0    + B*(-w) + C + D*0     + E*0      + F*(w*w);
      var c := A*w    + B*(-w) + C + D*(w*w) + E*(-w*w) + F*(w*w);
      var d := A*(-w) + B*0    + C + D*(w*w) + E*0      + F*0;
      var f := A*w    + B*0    + C + D*(w*w) + E*0      + F*0;
      var g := A*(-w) + B*w    + C + D*(w*w) + E*(-w*w) + F*(w*w);
      var h := A*0    + B*w    + C + D*0     + E*0      + F*(w*w);
      var i := A*w    + B*w    + C + D*(w*w) + E*(w*w)  + F*(w*w);
      DzDx(a, b, c, d, f, g, h, i, w) == A &&
      DzDy(a, b, c, d, f, g, h, i, w) == B
  {
    // 代数展开验证 (Dafny自动处理实数算术)
    // 分子部分展开后线性项精确匹配,二次项相消
    assert NumDx(a, b, c, d, f, g, h, i) == 8.0 * A * w;
    assert NumDy(a, b, c, d, f, g, h, i) == 8.0 * B * w;
  }

  // ------------------------------------------------------------------
  // 三次曲面: z = G·x³
  // 在原点(0,0)处,DzDx余项为 G·w² (真值导数为0)
  // ------------------------------------------------------------------
  lemma CubicRemainder(G: real, w: real)
    requires w > 0.0
    ensures 
      // 定义3x3窗口高程值 (仅x³项)
      var a := G * ((-w)*(-w)*(-w));  // (-w,-w): G·(-w)³ = -G·w³
      var b := G * (0*0*0);           // (0,-w): 0
      var c := G * (w*w*w);            // (w,-w): G·w³
      var d := G * ((-w)*(-w)*(-w));  // (-w,0): -G·w³
      var f := G * (w*w*w);            // (w,0): G·w³
      var g := G * ((-w)*(-w)*(-w));  // (-w,w): -G·w³
      var h := G * (0*0*0);            // (0,w): 0
      var i := G * (w*w*w);            // (w,w): G·w³
      DzDx(a, b, c, d, f, g, h, i, w) == G * w * w
  {
    // 分子展开: (c+2f+i) - (a+2d+g) = [G·w³ + 2·G·w³ + G·w³] - [-G·w³ -2·G·w³ -G·w³]
    assert NumDx(a, b, c, d, f, g, h, i) == 8.0 * G * (w*w*w);
    // 最终: [8·G·w³] / (8·w) = G·w²
  }

  // ==================================================================
  // 科学注记
  // ------------------------------------------------------------------
  // 1. 二次曲面精确性源于:
  //    - Horn差分格式是线性算子的离散精确实现
  //    - 二次曲面的二阶导数项在差分中相消
  //
  // 2. 三次曲面余项 O(w²) 表明:
  //    - 当 w→0 时, Horn差分收敛到真导数
  //    - 离散化误差随网格间距平方衰减
  //
  // 3. 推广结论: Horn算子是地形一阶导数的**一致估计量**
  //    (在真值可导且网格足够细时收敛)
  // ==================================================================
}

method Main() {
  print "GeoProofBench P-004 — Horn坡度在二次/三次曲面的代数性质\n";
  print "验证命令: dafny verify P004_consistency.dfy\n";
}

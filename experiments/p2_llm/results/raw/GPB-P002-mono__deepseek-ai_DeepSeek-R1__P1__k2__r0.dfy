module PitFill1D {

  // ===========================================================================
  //  GeoProofBench · P-COMP-1
  //  算子 : 1D Wang-Liu 填洼 (左出口)
  //  覆盖 : GPB-021 (填洼后单调非降)
  //  环境 : Dafny 4.11
  // ===========================================================================
  //
  //  科学动机
  //  ---------
  //  填洼是水文分析的基础算子。Wang-Liu 算法通过单次扫描实现 O(n) 复杂度，
  //  其核心性质是：
  //    (1) 高程提升单调性：任意单元高程在填洼后不会降低
  //    (2) 地形非降性：填洼后地形从左至右单调非降
  //
  //  本文件证明 1D 特化版本的基本代数性质，为 2D 填洼的终止性证明 (P-006)
  //  提供代数引理。
  //
  // ===========================================================================

  // 填洼算子定义
  function Fill(orig: seq<real>): (fill: seq<real>)
    requires |orig| >= 1  // 至少一个单元（左出口必需）
    ensures |fill| == |orig|
    ensures fill[0] == orig[0]  // 左边界条件
    ensures forall i :: 1 <= i < |orig| ==> 
      fill[i] == max(orig[i], fill[i-1])  // 核心递推式
    ensures forall i :: 0 <= i < |orig| ==> 
      orig[i] <= fill[i]  // 高程提升单调性 (GPB-021a)
    ensures forall i :: 1 <= i < |orig| ==> 
      fill[i-1] <= fill[i]  // 地形非降性 (GPB-021b)
  {
    if |orig| == 1 then
      [orig[0]]  // 单单元情形
    else
      var prefix := Fill(orig[0..|orig|-1]);  // 递归处理前缀
      var last := max(orig[|orig|-1], prefix[|prefix|-1]);  // 末位单元
      prefix + [last]  // 拼接结果
  }

  // ==================================================================
  // 辅助引理：最大值函数基本性质
  // ==================================================================
  lemma MaxProperty(a: real, b: real)
    ensures max(a, b) >= a
    ensures max(a, b) >= b
  {
    // Dafny 自动证明实数最大值性质
  }

  // ==================================================================
  // 主验证方法
  // ==================================================================
  method Main() {
    print "GeoProofBench P-COMP-1 — 1D Wang-Liu 填洼算子验证\n";
    print "已验证性质: 高程提升单调性 + 地形非降性 (GPB-021)\n";
  }
}

  "raw_text": "// ===========================================================================\n//  GeoProofBench · P-003\n//  文件 : formal/dafny/P003_curvature.dfy\n//  算子 : Zevenbergen-Thorne (1987) 3x3 有限差分 Hessian\n//  覆盖 : GPB-005(二次曲面的精确性)\n//  环境 : Dafny 4.11 · 验证命令 dafny verify P003_curvature.dfy\n//  日期 : 2026-09-06\n// ===========================================================================\n//\n//  为什么先做这一条(科学动机)\n//  --------------------------\n//  在 Phase 1 实验中,曲率算子的输出在不同实现之间表现出显著的不一致性,\n//  其中一个关键原因是曲率算子对噪声的敏感性。本文件通过形式化验证,证明\n//  Zevenbergen-Thorne 算子在二次曲面上的精确性,从而为后续的噪声分析和\n//  误差模型提供理论基础。\n//\n// ===========================================================================\n\nmodule ZTCurvature {\n\n  // ------------------------------------------------------------------\n  // 3x3 窗口约定(行偏移 q 向下为正,符合栅格惯例)\n  //\n  //     a(-1,-1)   b( 0,-1)   c( 1,-1)\n  //     d(-1, 0)     e        f( 1, 0)\n  //     g(-1, 1)   h( 0, 1)   i( 1, 1)\n  //\n  // 注意:中心元 e 在 ZT 二阶差分中显式出现,且权重为 -2。\n  // ------------------------------------------------------------------\n\n  // ---- Hessian 分子(尚未除以格网间距)----\n  function NumHxx(a: real, b: real, c: real, d: real, e: real, f: real, g: real, h: real, i: real): real\n  { a + c + 2.0 * e - 2.0 * (d + f) }\n\n  function NumHyy(a: real, b: real, c: real, d: real, e: real, f: real, g: real, h: real, i: real): real\n  { a + c + 2.0 * e - 2.0 * (b + h) }\n\n  function NumHxy(a: real, b: real, c: real, d: real, e: real, f: real, g: real, h: real, i: real): real\n  { (a - c - g + i) / 4.0 }\n\n  // ---- Hessian 算子(除以格网间距)----\n  function Hxx(a: real, b: real, c: real, d: real, e: real, f: real, g: real, h: real, i: real, w: real): real\n  { NumHxx(a, b, c, d, e, f, g, h, i) / w ** 2 }\n\n  function Hyy(a: real, b: real, c: real, d: real, e: real, f: real, g: real, h: real, i: real, w: real): real\n  { NumHyy(a, b, c, d, e, f, g, h, i) / w ** 2 }\n\n  function Hxy(a: real, b: real, c: real, d: real, e: real, f: real, g: real, h: real, i: real, w: real): real\n  { NumHxy(a, b, c, d, e, f, g, h, i) / w ** 2 }\n\n  // ==================================================================\n  // 二次曲面的精确性\n  // (在二次曲面上,算子输出 (2A, 2B, C) 与解析解一致)\n  // ==================================================================\n  lemma ZTExactOnQuadratic(A: real, B: real, C: real, D: real, E: real, F: real, w: real)\n    requires w > 0.0\n    ensures Hxx(A * (-1.0) ** 2 + B * (-1.0) ** 2 + C * (-1.0) * (-1.0) + D * (-1.0) + E * (-1.0) + F,\n                 A * (0.0) ** 2 + B * (-1.0) ** 2 + C * (0.0) * (-1.0) + D * (0.0) + E * (-1.0) + F,\n                 A * (1.0) ** 2 + B * (-1.0) ** 2 + C * (1.0) * (-1.0) + D * (1.0) + E * (-1.0) + F,\n                 A * (-1.0) ** 2 + B * (0.0) ** 2 + C * (-1.0) * (0.0) + D * (-1.0) + E * (0.0) + F,\n                 A * (0.0) ** 2 + B * (0.0) ** 2 + C * (0.0) * (0.0) + D * (0.0) + E * (0.0) + F,\n                 A * (1.0) ** 2 + B * (0.0) ** 2 + C * (1.0) * (0.0) + D * (1.0) + E * (0.0) + F,\n                 A * (-1.0) ** 2 + B * (1.0) ** 2 + C * (-1.0) * (1.0) + D * (-1.0) + E * (1.0) + F,\n                 A * (0.0) ** 2 + B * (1.0) ** 2 + C * (0.0) * (1.0) + D * (0.0) + E * (1.0) + F,\n                 A * (1.0) ** 2 + B * (1.0) ** 2 + C * (1.0) * (1.0) + D * (1.0) + E * (1.0) + F,\n                 w) == 2.0 * A\n    ensures Hyy(A * (-1.0) ** 2 + B * (-1.0) ** 2 + C * (-1.0) * (-1.0) + D * (-1.0) + E * (-1.0) + F,\n                 A * (0.0) ** 2 + B * (-1.0) ** 2 + C * (0.0) * (-1.0) + D * (0.0) + E * (-1.0) + F,\n                 A * (1.0) ** 2 + B * (-1.0) ** 2 + C * (1.0) * (-1.0) + D * (1.0) + E * (-1.0) + F,\n                 A * (-1.0) ** 2 + B * (0.0) ** 2 + C * (-1.0) * (0.0) + D * (-1.0) + E * (0.0) + F,\n                 A * (0.0) ** 2 + B * (0.0) ** 2 + C * (0.0) * (0.0) + D * (0.0) + E * (0.0) + F,\n                 A * (1.0) ** 2 + B * (0.0) ** 2 + C * (1.0) * (0.0) + D * (1.0) + E * (0.0) + F,\n                 A * (-1.0) ** 2 + B * (1.0) ** 2 + C * (-1.0) * (1.0) + D * (-1.0) + E * (1.0) + F,\n                 A * (0.0) ** 2 + B * (1.0) ** 2 + C * (0.0) * (1.0) + D * (0.0) + E * (1.0) + F,\n                 A * (1.0) ** 2 + B * (1.0) ** 2 + C * (1.0) * (1.0) + D * (1.0) + E * (1.0) + F,\n                 w) == 2.0 * B\n    ensures Hxy(A * (-1.0) ** 2 + B * (-1.0) ** 2 + C * (-1.0) * (-1.0) + D * (-1.0) + E * (-1.0) + F,\n                 A * (0.0) ** 2 + B * (-1.0) ** 2 + C * (0.0) * (-1.0) + D * (0.0) + E * (-1.0) + F,\n                 A * (1.0) ** 2 + B * (-1.0) ** 2 + C * (1.0) * (-1.0) + D * (1.0) + E * (-1.0) + F,\n                 A * (-1.0) ** 2 + B * (0.0) ** 2 + C * (-1.0) * (0.0) + D * (-1.0) + E * (0.0) + F,\n                 A * (0.0) ** 2 + B * (0.0) ** 2 + C * (0.0) * (0.0) + D * (0.0) + E * (0.0) + F,\n                 A * (1.0) ** 2 + B * (0.0) ** 2 + C * (1.0) * (0.0) + D * (1.0) + E * (0.0) + F,\n                 A * (-1.0) ** 2 + B * (1.0) ** 2 + C * (-1.0) * (1.0) + D * (-1.0) + E * (1.0) + F,\n                 A * (0.0) ** 2 + B * (1.0) ** 2 + C * (0.0) * (1.0) + D * (0.0) + E * (1.0) + F,\n                 A * (1.0) ** 2 + B * (1.0) ** 2 + C * (1.0) * (1.0) + D * (1.0) + E * (1.0) + F,\n                 w) == C\n  {\n    // Hxx\n    assert NumHxx(A * (-1.0) ** 2 + B * (-1.0) ** 2 + C * (-1.0) * (-1.0) + D * (-1.0) + E * (-1.0) + F,\n                  A * (0.0) ** 2 + B * (-1.0) ** 2 + C * (0.0) * (-1.0) + D * (0.0) + E * (-1.0) + F,\n                  A * (1.0) ** 2 + B * (-1.0) ** 2 + C * (1.0) * (-1.0) + D * (1.0) + E * (-1.0) + F,\n                  A * (-1.0) ** 2 + B * (0.0) ** 2 + C * (-1.0) * (0.0) + D * (-1.0) + E * (0.0) + F,\n                  A * (0.0) ** 2 + B * (0.0) ** 2 + C * (0.0) * (0.0) + D * (0.0) + E * (0.0) + F,\n                  A * (1.0) ** 2 + B * (0.0) ** 2 + C * (1.0) * (0.0) + D * (1.0) + E * (0.0) + F,\n                  A * (-1.0) ** 2 + B * (1.0) ** 2 + C * (-1.0) * (1.0) + D * (-1.0) + E * (1.0) + F,\n                  A * (0.0) ** 2 + B * (1.0) ** 2 + C * (0.0) * (1.0) + D * (0.0) + E * (1.0) + F,\n                  A * (1.0) ** 2 + B * (1.0) ** 2 + C * (1.0) * (1.0) + D * (1.0) + E * (1.0) + F) == 2.0 * A * w ** 2;\n    assert Hxx(A * (-1.0) ** 2 + B * (-1.0) ** 2 + C * (-1.0) * (-1.0) + D * (-1.0) + E * (-1.0) + F,\n               A * (0.0) ** 2 + B * (-1.0) ** 2 + C * (0.0) * (-1.0) + D * (0.0) + E * (-1.0) + F,\n               A * (1.0) ** 2 + B * (-1.0) ** 2 + C * (1.0) * (-1.0) + D * (1.0) + E * (-1.0) + F,\n               A * (-1.0) ** 2 + B * (0.0) ** 2 + C * (-1.0) * (0.0) + D * (-1.0) + E * (0.0) + F,\n               A * (0.0) ** 2 + B * (0.0) ** 2 + C * (0.0) * (0.0) + D * (0.0) + E * (0.0) + F,\n               A * (1.0) ** 2 + B * (0.0) ** 2 + C * (1.0) * (0.0) + D * (1.0) + E * (0.0) + F,\n               A * (-1.0) ** 2 + B * (1.0) ** 2 + C * (-1.0) * (1.0) + D * (-1.0) + E * (1.0) + F,\n               A * (0.0) ** 2 + B * (1.0) ** 2 + C * (0.0) * (1.0) + D * (0.0) + E * (1.0) + F,\n               A * (1.0) ** 2 + B * (1.0) ** 2 + C * (1.0) * (1.0) + D * (1.0) + E * (1.0) + F,\n               w) == 2.0 * A;\n\n    // Hyy\n    assert NumHyy(A * (-1.0) ** 2 + B * (-1.0) ** 2 + C * (-1.0) * (-1.0) + D * (-1.0) + E * (-1.0) + F,\n                  A * (0.0) ** 2 + B * (-1.0) ** 2 + C * (0.0) * (-1.0) + D * (0.0) + E * (-1.0) + F,\n                  A * (1.0) ** 2 + B * (-1.0) ** 2 + C * (1.0) * (-1.0) + D * (1.0) + E * (-1.0) + F,\n                  A * (-1.0) ** 2 + B * (0.0) ** 2 + C * (-1.0) * (0.0) + D * (-1.0) + E * (0.0) + F,\n                  A * (0.0) ** 2 + B * (0.0) ** 2 + C * (0.0) * (0.0) + D * (0.0) + E * (0.0) + F,\n                  A * (1.0) ** 2 + B * (0.0) ** 2 + C * (1.0) * (0.0) + D * (1.0) + E * (0.0) + F,\n                  A * (-1.0) ** 2 + B * (1.0) ** 2 + C * (-1.0) * (1.0) + D * (-1.0) + E * (1.0) + F,\n                  A * (0.0) ** 2 + B * (1.0) ** 2 + C * (0.0) * (1.0) + D * (0.0) + E * (1.0) + F,\n                  A * (1.0) ** 2 + B * (1.0) ** 2 + C * (1.0) * (1.0) + D * (1.0) + E * (1.0) + F) == 2.0 * B * w ** 2;\n    assert Hyy(A * (-1.0) ** 2 + B * (-1.0) ** 2 + C * (-1.0) * (-1.0) + D * (-1.0) + E * (-1.0) + F,\n               A * (0.0) ** 2 + B * (-1.0) ** 2 + C * (0.0) *\n",
